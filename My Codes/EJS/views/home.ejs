<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rolldice Page</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f7a5a5;
            text-align: center;
            padding: 50px;
        }

        h1 {
            color: #333;
        }

        p {
            font-size: 18px;
            color: #555;
        }

        a {
            text-decoration: none;
            color: #007BFF;
        }

        a:hover {
            color: #0056b3;
        }
    </style>
</head>

<body>

    <h1>Welcome to My Home Page</h1>
    <p>This is a basic HTML home page created for practice.</p>

    <h5>Interpolation Syntax</h5>
    <h3>
        <%= 1+2 %>
    </h3> <!--3-->
    <h3>
        <%= 'apple' .toUpperCase() %>
    </h3> <!--APPLE-->
    <h3>
        <%= ['bye','gn'][1] %>
    </h3> <!--gn-->

    <h3>dice rolled no : <%= diceVal %>
    </h3>


</body>

</html>