<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Post</title>
</head>

<body>
    <h1>Edit your Post :</h1>
    <h3>Post id : <%=post.id%>
    </h3>
    <h3>Post Username : @<%=post.username%>
    </h3>
    <br>
    <br>
    <form method="post" action="/posts/<%=post.id%>?_method=PATCH">
        <!--form k post method ko patch me badalne k liy method override package se-->
        <textarea rows="10" cols="30" name="content"><%= post.content %></textarea>
        <button>Submit</button>
    </form>


</body>

</html>